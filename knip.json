{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "project": ["src/**/*.{ts,vue}"],
  "entry": ["src/**/__tests__/*.spec.ts"],
  "ignoreExportsUsedInFile": true,
  "rules": {
    "exports": "error",
    "types": "error",
    "unresolved": "error"
  },
  "ignoreDependencies": ["@vue/compiler-dom", "@vue/server-renderer"],
  "ignore": ["src/models/survey/stackTraverser.ts"]
}
