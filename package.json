{
  "name": "icrashedmyplane",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.7.0"
  },
  "scripts": {
    "build": "run-p type-check \"build-only {@}\" --",
    "build-only": "vite build",
    "dev": "vite",
    "doc": "npx typedoc --out docs src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:eslint": "eslint .",
    "lint:stylelint": "stylelint \"src/**/*.{vue,css,scss,sass}\" \"public/*.css\"",
    "lint:oxlint": "oxlint -c oxlintrc.json src",
    "lint:knip": "knip",
    "lint": "run-s 'lint:*'",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:e2e:dev": "playwright test --ui",
    "test:unit": "vitest",
    "type-check": "vue-tsc --build"
  },
  "dependencies": {
    "@intlify/core-base": "^11.4.8",
    "@sentry/vue": "^10.70.0",
    "cldr-data": "^36.0.5",
    "cldrjs": "^0.5.5",
    "lodash-es": "^4.18.1",
    "normalize.css": "^8.0.1",
    "pinia": "^4.0.3",
    "vue": "^3.5.41",
    "vue-i18n": "^11.4.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@pinia/testing": "^2.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/vue": "^8.1.0",
    "@tsconfig/node26": "^26.0.1",
    "@types/cldrjs": "^0.4.29",
    "@types/jsdom": "^30.0.0",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^26.2.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/compiler-dom": "^3.5.41",
    "@vue/server-renderer": "^3.5.41",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.8.1",
    "eslint-plugin-vue": "^10.10.0",
    "jiti": "^2.7.0",
    "jsdom": "^30.0.1",
    "knip": "^6.32.2",
    "npm-run-all2": "^9.0.3",
    "oxlint": "^1.79.0",
    "postcss": "^8.5.26",
    "postcss-html": "^2.0.0",
    "prettier": "^3.9.6",
    "sass": "^1.102.0",
    "stylelint": "^17.14.1",
    "stylelint-config-standard-scss": "^17.0.0",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^4.1.11",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.10",
    "wrangler": "^4.124.0"
  },
  "packageManager": "pnpm@11.22.0"
}
